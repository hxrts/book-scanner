# copy to ~/.config/scanner/scanner.env on the Pi and fill in

# Google Sheets: share the sheet with the service account's client_email (Editor)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Books
GOOGLE_CREDENTIALS=/home/pi/.config/scanner/service-account.json

# Are.na: personal access token with *write* scope, from https://www.are.na/settings/personal-access-tokens
ARENA_TOKEN=
# channel slug or id
ARENA_CHANNEL=

# contact sent in the User-Agent, as Are.na requests (URL or email)
SCANNER_CONTACT=

# optional tuning
#SCANNER_DEVICE=/dev/video0
#SCANNER_WIDTH=1920
# lens focus: calibrate (lock onto the first page seen after start), auto
# (continuous autofocus) or a fixed value 0-255
#SCANNER_FOCUS=calibrate
# rotate frames clockwise so pages read upright (0/90/180/270)
#SCANNER_ROTATE=0
#SCANNER_HEIGHT=1080
#SCANNER_PAGE_MIN_AREA=0.15
# padding around a page found by its text (fraction of its longer side)
#SCANNER_PAGE_MARGIN=0.12
#SCANNER_PAGE_STABLE_S=1.0
# pages blurrier than this focus score are skipped (score is logged per capture)
#SCANNER_MIN_FOCUS=0.33
#SCANNER_ISBN_COOLDOWN_S=60
#SCANNER_OCR_LANG=eng
# frames averaged per page capture (1 disables)
#SCANNER_STACK_FRAMES=5
# tessdata_best models: ~3 points better OCR, ~3x slower
#SCANNER_TESSDATA_DIR=/home/pi/tessdata-best
# corpus for context-aware OCR correction (empty disables)
#SCANNER_LM_CORPUS=/home/pi/scanner/data/big.txt
# max MB of images kept from finished scans; oldest deleted first (pending never)
#SCANNER_KEEP_MB=2048
