# copy to ~/.config/scanner/scanner.env on the Pi and fill in

# Google Sheets: share the sheet with the service account's client_email (Editor)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Books
GOOGLE_CREDENTIALS=/home/pi/.config/scanner/service-account.json

# Are.na: personal access token with *write* scope, from https://www.are.na/settings/personal-access-tokens
ARENA_TOKEN=
# channel slug or id
ARENA_CHANNEL=

# contact sent in the User-Agent, as Are.na requests (URL or email)
SCANNER_CONTACT=

# optional tuning
#SCANNER_DEVICE=/dev/video0
#SCANNER_WIDTH=1920
#SCANNER_HEIGHT=1080
#SCANNER_PAGE_MIN_AREA=0.15
#SCANNER_PAGE_STABLE_S=1.0
# pages blurrier than this focus score are skipped (score is logged per capture)
#SCANNER_MIN_SHARPNESS=30
#SCANNER_ISBN_COOLDOWN_S=60
#SCANNER_OCR_LANG=eng
# max MB of images kept from finished scans; oldest deleted first (pending never)
#SCANNER_KEEP_MB=2048
