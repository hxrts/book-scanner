#!/bin/bash
# Control the book scanner on the Pi. Installed as `scanner` by deploy.sh.
set -euo pipefail
DATA=${SCANNER_DATA_DIR:-~/scanner-data}
ENV=~/.config/scanner/scanner.env

usage() {
  cat <<'EOF'
usage: scanner <command>

  start             start scanning and show the live feed
  stop              stop scanning
  restart           restart (re-learns the mat, recalibrates focus)
  status            is it running, plus the last few log lines
  logs              live status feed (Ctrl+C to stop watching)
  raw               the unformatted log
  calibrate [--full]
                    recalibrate focus on the next page; --full forgets the
                    saved focus and sweeps around the default
  color REF [PAGE]  fit colour correction from a reference image of a scanned
                    page (PAGE defaults to the latest scan), then restart
  pending           pages waiting to be processed or uploaded
  snapshot          save what the detector sees to ~/scanner-data/debug
  config            edit settings, then restart
  boot on|off       start automatically at boot, or not
EOF
}

svc() { sudo systemctl "$@" scanner; }
if [ -t 1 ]; then G=$'\e[32m' D=$'\e[2m' R=$'\e[31m' N=$'\e[0m'; else G= D= R= N=; fi
say()  { echo "${G}$*${N}"; }
hint() { echo "${D}$*${N}"; }
# live status feed from CURSOR (taken before starting, so nothing is missed) or the last N lines;
# Ctrl+C stops watching, the scanner keeps running
feed() { hint "live status below (Ctrl+C stops watching; the scanner keeps running)"
         local from=(-n "${1:-30}"); [ -n "${CURSOR:-}" ] && from=(--after-cursor "$CURSOR")
         # don't echo keys pressed while watching (arrows and scrolling show up as ^[[B)
         if [ -t 0 ]; then TTY_SAVED=$(stty -g); stty -echo; trap 'stty "$TTY_SAVED"' EXIT; fi
         journalctl -u scanner -f "${from[@]}" -o cat | (cd ~/scanner && exec .venv/bin/python -m scanner.watch) || true; }
# stop the service and any scanner started by hand (python -m scanner.main), which would
# otherwise hold the camera
# the command line must start with the python binary, so shells that merely mention it don't match
HAND='^[^ ]*python[0-9.]* -m scanner\.main( |$)'
stop_all() {
  if systemctl -q is-active scanner; then svc stop; hint "stopped the running scanner service"; fi
  local pids; pids=$(pgrep -f "$HAND" || true)
  if [ -n "$pids" ]; then
    hint "stopping scanner started by hand (pid $(echo $pids))"
    kill $pids 2>/dev/null || sudo kill $pids
    for _ in $(seq 10); do pgrep -f "$HAND" >/dev/null || break; sleep 0.5; done
    pkill -9 -f "$HAND" 2>/dev/null || sudo pkill -9 -f "$HAND" || true
  fi
}
# start or restart, then follow along from that moment
launch() {
  local dev; dev=$(grep -s '^SCANNER_DEVICE=' "$ENV" | cut -d= -f2 || true); dev=${dev:-/dev/video0}
  if [ ! -e "$dev" ]; then
    echo "${R}webcam $dev not found; not starting${N}"
    hint "check its USB cable; if it keeps dropping out, the Pi's power supply is too weak (see: dmesg | grep -i voltage)"
    exit 1
  fi
  stop_all
  CURSOR=$(journalctl -u scanner -n 1 -q --show-cursor | sed -n 's/^-- cursor: //p')
  svc start; say "scanner ${2}"; feed
}

case "${1:-}" in
  start)   launch start started ;;
  stop)    stop_all;    say "scanner stopped" ;;
  restart) launch restart restarted ;;
  status)
    if systemctl -q is-active scanner; then say "running"; else echo "${R}not running${N}"; fi
    journalctl -u scanner -n 30 --no-pager -o cat | (cd ~/scanner && .venv/bin/python -m scanner.watch) | tail -8 ;;
  logs)    feed 30 ;;
  raw)     journalctl -u scanner -f -n 30 -o cat ;;
  calibrate)
    [ "${2:-}" = "--full" ] && rm -f "$DATA/focus.txt"
    launch restart "restarted to recalibrate" ;;
  color)
    ref=${2:?usage: scanner color REF [PAGE]}
    page=${3:-$(ls -t "$DATA"/done/*/page.jpg 2>/dev/null | head -1)}
    [ -n "$page" ] || { echo "no scanned page found; scan one first" >&2; exit 1; }
    echo "fitting against $page"
    cd ~/scanner && .venv/bin/python -m scanner.colorfit "$ref" "$page"
    svc restart; say "restarted with the new colour correction" ;;
  pending) ls -1 "$DATA/pending" 2>/dev/null || echo "nothing pending" ;;
  snapshot)
    touch /tmp/scanner-dump
    for _ in $(seq 20); do [ -e /tmp/scanner-dump ] || break; sleep 0.5; done
    [ -e /tmp/scanner-dump ] && { rm -f /tmp/scanner-dump; echo "no snapshot; is the scanner running?" >&2; exit 1; }
    ls -l "$DATA/debug" ;;
  config)  ${EDITOR:-nano} "$ENV"; svc restart; say "restarted with new settings" ;;
  boot)
    case "${2:-}" in
      on)  svc enable;  say "will start at boot" ;;
      off) svc disable; say "won't start at boot" ;;
      *)   usage; exit 1 ;;
    esac ;;
  ""|-h|--help|help) usage ;;
  *) echo "unknown command: $1" >&2; usage; exit 1 ;;
esac
